# ==============================================================================
# BrandBid.me — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Dodo Payments (Merchant of Record & Global Checkout)
# Dashboard: https://app.dodopayments.com/developer
# ------------------------------------------------------------------------------
# Secret API key from Dodo Developer Console.
# IMPORTANT: Server-only variable. Never expose to client-side code or prefix with NEXT_PUBLIC_.
DODO_PAYMENTS_API_KEY=

# Webhook signing key (starts with whsec_...) from Dodo Developer > Webhooks.
# IMPORTANT: Server-only variable. Never expose to client-side code or prefix with NEXT_PUBLIC_.
DODO_PAYMENTS_WEBHOOK_KEY=

# Product ID representing BrandBid placement bids (from Dodo Product Catalog).
DODO_PAYMENTS_PRODUCT_ID=

# Environment mode: "test_mode" for sandbox/testing, "live_mode" for production.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Optional return URL after completing checkout (defaults to /checkout/success).
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/checkout/success

# ------------------------------------------------------------------------------
# Application & Persistence Configuration
# ------------------------------------------------------------------------------
# Public base URL of the application.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connection:
# - Production (PostgreSQL / Supabase): postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# - Local Development: file:./brandbid.db
DATABASE_URL=file:./brandbid.db

# Admin Panel Secret (/admin):
ADMIN_SECRET=
