# BrandBid.me Environment Configuration

# Database
# For Production (PostgreSQL / Supabase):
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# For Local Dev (Embedded SQLite or Local PostgreSQL):
DATABASE_URL=file:./brandbid.db

# Razorpay (Payment Gateway)
# Test keys available at https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key

# Admin & Security
ADMIN_SECRET=brandbid_admin_super_secret_key_2026
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Analytics & Monitoring
# NEXT_PUBLIC_POSTHOG_KEY=phc_placeholder
# SENTRY_DSN=https://placeholder@sentry.io/123456
