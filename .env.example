# BrandBid.me Environment Configuration

# Database
# For Production (PostgreSQL / Supabase):
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# For Local Dev (Embedded SQLite or Local PostgreSQL):
DATABASE_URL=file:./brandbid.db

# Dodo Payments (Merchant of Record & Global Checkout)
# Production requires valid live values (no placeholders) and fails closed when missing.
# API keys available at https://app.dodopayments.com/developer
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=dp_test_xxx
DODO_PAYMENTS_PRODUCT_ID=pdt_xxx
# Use the webhook signing key from Dodo dashboard webhook settings
DODO_PAYMENTS_WEBHOOK_KEY=whsec_xxx
# Optional compatibility alias (same value as DODO_PAYMENTS_WEBHOOK_KEY)
DODO_PAYMENTS_WEBHOOK_SECRET=whsec_xxx

# Canonical Dodo return + webhook URLs are built from NEXT_PUBLIC_APP_URL:
# Return URL: {NEXT_PUBLIC_APP_URL}/checkout/success
# Webhook URL to configure in Dodo Dashboard: {NEXT_PUBLIC_APP_URL}/api/webhook/dodo-payments
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin & Security
ADMIN_SECRET=brandbid_admin_super_secret_key_2026

# Legacy Gateway (Optional Fallback)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key
